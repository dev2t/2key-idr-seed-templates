{
	"$schema": "../../schemas/catalog.schema.json",
	"schemaVersion": 1,
	"surfaces": ["secmail", "office"],
	"platforms": ["linux"],
	"hosts": {
		"secmailDesktop": {
			"surfaces": ["secmail"],
			"excludePlatforms": ["linux"]
		},
		"secmailLinux": {
			"surfaces": ["secmail"]
		},
		"office": {
			"surfaces": ["office"],
			"excludePlatforms": ["linux"]
		}
	},
	"products": {
		"secmail": {
			"displayName": "SecMail",
			"description": "Scomm Email and Office add-ons",
			"isActive": true,
			"meters": {
				"scomm.ai.tokens": {
					"displayName": "Scomm AI tokens",
					"unit": "token",
					"aggregation": "sum"
				}
			},
			"offerings": {
				"pgp": {
					"displayName": "Outlook OpenPGP ECC",
					"settings": {
						"surfaces": ["office"]
					}
				},
				"pqc": {
					"displayName": "Outlook OpenPGP ECC+PQC",
					"settings": {
						"surfaces": ["secmail", "office"]
					}
				},
				"linux": {
					"displayName": "Linux Version",
					"settings": {
						"surfaces": ["secmail"],
						"platforms": ["linux"]
					}
				},
				"ai_assistant": {
					"displayName": "Local-AI",
					"settings": {
						"surfaces": ["secmail", "office"]
					}
				}
			},
			"plans": {
				"pgp": {
					"displayName": "Outlook OpenPGP ECC",
					"offerings": { "pgp": 1 },
					"pricings": {
						"annual": { "currency": "USD", "basePrice": 5 }
					}
				},
				"pqc": {
					"displayName": "Outlook OpenPGP ECC+PQC",
					"offerings": { "pqc": 1 },
					"pricings": {
						"annual": { "currency": "USD", "basePrice": 15 }
					}
				},
				"linux": {
					"displayName": "Linux Version",
					"offerings": { "linux": 1 },
					"pricings": {
						"annual": { "currency": "USD", "basePrice": 5 }
					}
				},
				"ai_assistant": {
					"displayName": "Local-AI",
					"offerings": { "ai_assistant": 1 },
					"pricings": {
						"annual": { "currency": "USD", "basePrice": 5 }
					}
				}
			}
		}
	}
}
